        },
        "card-2": {
          "type": "card",
          "settings": {
            "card_style": "fix",
            "eyebrow": "The fix",
            "heading": "Compression + warmth + proprioception.",
            "body": "<p>Waldon wraps the joint in three things at once: steady pressure to push out swelling, body heat to loosen stiffness, and gentle support so your knee remembers how to move.</p>"
          }
        }
      },

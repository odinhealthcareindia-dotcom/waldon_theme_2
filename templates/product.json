        "review-2": {
          "type": "review",
          "settings": {
            "reviewer_name": "David W.",
            "reviewer_age": 72,
            "date": "Feb 28",
            "rating": 5,
            "headline": "Post-surgery must-have.",
            "body": "<p>My surgeon actually suggested compression after my partial knee replacement. Tried two other brands first — both slipped. Waldon stays put, doesn't itch, and the swelling goes down noticeably by mid-morning. Well worth it.</p>",
            "image_1_label": "Week 1",
            "image_2_label": "Week 6",
            "tags": "post-surgery,swelling",

    "features-list": {
      "type": "features-list",
      "blocks": {
        "feat-1": {
          "type": "feature",
          "settings": {
            "heading": "Three-zone graduated compression.",
            "body": "<p>Firmest at the calf, medium at the knee, gentle at the thigh. It pushes fluid up and out — which is why swelling drops within hours, not weeks.</p>",
            "pill_text": "72% less swelling by week 4"
          }
        },
        "feat-2": {
          "type": "feature",
          "settings": {
            "heading": "Medical-grade knit that breathes.",
            "body": "<p>4-way stretch nylon with moisture-wicking elastane. Cool enough to wear in bed. Strong enough to hold through a full shift on your feet.</p>",
            "pill_text": "12-hour comfort wear"
          }
        },
        "feat-3": {
          "type": "feature",
          "settings": {
            "heading": "Silicone grips that actually grip.",
            "body": "<p>Two bands of medical silicone — one top, one bottom — anchor the sleeve so it doesn't inch down when you climb stairs, garden, or get up from the couch.</p>",
            "pill_text": "No-slip guarantee"
          }
        },
        "feat-4": {
          "type": "feature",
          "settings": {
            "heading": "Warm the joint, calm the ache.",
            "body": "<p>The knit traps body heat and holds it against the kneecap. Warmth loosens the joint capsule, which is why mornings stop starting with a grimace.</p>",
            "pill_text": "Feels like a warm hand on the knee"
          }
        }
      },
      "block_order": [
        "feat-1",

{%- assign tones = 'clay,stone,sage,brass,slate' | split: ',' -%}

<section class="wd-new-section">
  <div class="wd-container">
    <div class="wd-new">
      <div class="wd-new-head">
        {% if section.settings.eyebrow != blank %}
          <div class="wd-eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}
        <h2 class="wd-section-title">{{ section.settings.title }}</h2>
      </div>

      <div class="wd-new-scroller">
        {%- if section.settings.collection != blank -%}
          {%- for product in section.settings.collection.products limit: section.settings.max_products -%}
            {%- assign tone_index = forloop.index0 | modulo: 5 -%}
            {%- assign tone = tones[tone_index] -%}
            <a href="{{ product.url }}" class="wd-new-card">
              <div class="wd-new-img wd-img-{{ tone }}">
                {% if product.featured_image %}
                  {{ product.featured_image | image_url: width: 500 | image_tag:
                    loading: 'lazy',
                    widths: '250, 375, 500',
                    sizes: '(max-width: 600px) 100vw, (max-width: 900px) 50vw, 25vw'
                  }}
                {% endif %}
                {% if product.metafields.custom.badge != blank %}
                  <span class="wd-new-flag">{{ product.metafields.custom.badge }}</span>
                {% elsif forloop.index <= 2 %}
                  <span class="wd-new-flag">New</span>
                {% endif %}
              </div>
              <div class="wd-new-body">
                {% if product.type != blank %}
                  <span class="wd-mono-caption">{{ product.type }}</span>
                {% endif %}
                <div class="wd-new-name">{{ product.title }}</div>
                <span class="wd-price-sm">{{ product.price | money }}</span>
              </div>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- assign placeholder_items = '1,2,3,4' | split: ',' -%}
          {%- for i in placeholder_items -%}
            {%- assign tone_index = forloop.index0 | modulo: 5 -%}
            {%- assign tone = tones[tone_index] -%}
            <div class="wd-new-card">
              <div class="wd-new-img wd-img-{{ tone }}">
                {% if forloop.index <= 2 %}
                  <span class="wd-new-flag">New</span>
                {% endif %}
              </div>
              <div class="wd-new-body">
                <span class="wd-mono-caption">Category</span>
                <div class="wd-new-name">Product name</div>
                <span class="wd-price-sm">$00.00</span>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New arrivals",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New in"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Recently added."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "New arrivals"
    }
  ]
}
{% endschema %}

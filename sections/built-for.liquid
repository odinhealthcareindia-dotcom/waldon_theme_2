{% comment %}
  Built-For section — metaobject-bound (type: built_for_item)
  Data resolution order:
    1. product.metafields.custom.built_for.value  (product-level list of built_for_item metaobjects)
    2. section.blocks of type 'item'               (fallback — editable in theme editor)
  To connect at product level:
    1. In Shopify Admin → Content → Metaobjects → create definition "Built-for item" (type: built_for_item)
       Add field: label (Single line text)
    2. In Shopify Admin → Settings → Custom data → Products → add metafield
       Namespace: custom, Key: built_for, Type: Metaobject (list), Metaobject: built_for_item
    3. On each product edit page, populate the "Built for" metafield
{% endcomment %}

{%- liquid
  assign meta_items = product.metafields.custom.built_for.value
  assign has_items = false
  if meta_items != blank and meta_items.size > 0
    assign has_items = true
  endif
  if has_items == false and section.blocks.size > 0
    assign has_items = true
  endif
-%}

{%- if has_items and section.settings.show_section -%}
<section class="bf-section section--built-for" style="background: {{ section.settings.bg_color }};">
  <div class="bf-inner">
    <p class="bf-eyebrow">{{ section.settings.heading }}</p>
    <div class="bf-grid">

      {%- if meta_items != blank and meta_items.size > 0 -%}
        {%- for item in meta_items -%}
          <div class="bf-chip">
            <span class="bf-chip__check">
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 6 5 9 10 3"/></svg>
            </span>
            <span>{{ item.label.value | default: item.label }}</span>
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'item' -%}
            <div class="bf-chip" {{ block.shopify_attributes }}>
              <span class="bf-chip__check">
                <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 6 5 9 10 3"/></svg>
              </span>
              <span>{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.section--built-for { border-bottom: 1px solid var(--stone-01); }
.bf-inner {
  max-width: var(--content-max, 1120px); margin: 0 auto;
  padding: 40px 18px;
}
@media (min-width: 768px) { .bf-inner { padding: 56px 48px; } }

.bf-eyebrow {
  font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--fg-muted); margin: 0 0 16px; font-weight: 500;
}

.bf-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}
@media (min-width: 600px) { .bf-grid { gap: 10px; } }

.bf-chip {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 14px;
  background: var(--sage-50, #EEF1EA);
  border: 1px solid var(--sage-100, #D8DFCF);
  border-radius: 8px;
  font-family: var(--font-sans); font-size: 13px; color: var(--ink-00);
  line-height: 1.3;
}

.bf-chip__check {
  width: 20px; height: 20px; min-width: 20px; border-radius: 999px;
  background: var(--sage-600, #6B7860);
  display: flex; align-items: center; justify-content: center;
  color: #fff;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Built for",
  "tag": "section",
  "class": "section section--built-for",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FBF9F4" },
    { "type": "text", "id": "heading", "label": "Eyebrow heading", "default": "Built for" },
    {
      "type": "paragraph",
      "content": "To power this section from product metafields: 1) Create a metaobject definition named 'Built-for item' (type: built_for_item) with a 'label' text field in Content → Metaobjects. 2) Add a product metafield: namespace 'custom', key 'built_for', type 'Metaobject list → built_for_item' in Settings → Custom data → Products. 3) Populate the metafield on each product."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Fallback item",
      "limit": 16,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Arthritis & joint pain" }
      ]
    }
  ],
  "presets": [{
    "name": "Built for",
    "blocks": [
      { "type": "item", "settings": { "label": "Arthritis & joint pain" } },
      { "type": "item", "settings": { "label": "Swelling & fluid retention" } },
      { "type": "item", "settings": { "label": "Stiffness in the morning" } },
      { "type": "item", "settings": { "label": "Post-surgery recovery" } },
      { "type": "item", "settings": { "label": "Pain on the stairs" } },
      { "type": "item", "settings": { "label": "Standing all day" } },
      { "type": "item", "settings": { "label": "Aching while sleeping" } },
      { "type": "item", "settings": { "label": "Bone-on-bone grinding" } }
    ]
  }]
}
{% endschema %}

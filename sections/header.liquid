<nav class="wd-nav">
  <a class="wd-nav-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    {%- if settings.logo -%}
      {%- assign logo_h   = settings.logo_height        | default: 36 -%}
      {%- assign logo_h_m = settings.logo_height_mobile | default: 28 -%}
      {%- assign logo_w   = logo_h   | times: settings.logo.aspect_ratio | ceil -%}
      {%- assign logo_w_m = logo_h_m | times: settings.logo.aspect_ratio | ceil -%}
      {%- assign logo_h2  = logo_h   | times: 2 -%}
      {%- assign logo_h3  = logo_h   | times: 3 -%}
      {%- capture logo_srcset -%}
        {{ settings.logo | image_url: height: logo_h }} 1x,
        {{ settings.logo | image_url: height: logo_h2 }} 2x,
        {{ settings.logo | image_url: height: logo_h3 }} 3x
      {%- endcapture -%}
      <img
        src="{{ settings.logo | image_url: height: logo_h }}"
        srcset="{{ logo_srcset }}"
        alt="{{ settings.logo.alt | default: shop.name | escape }}"
        width="{{ logo_w }}"
        height="{{ logo_h }}"
        class="wd-nav-logo"
        style="--logo-h: {{ logo_h }}px; --logo-h-m: {{ logo_h_m }}px; --logo-w: {{ logo_w }}px; --logo-w-m: {{ logo_w_m }}px;"
        loading="eager">
    {%- else -%}
      {% comment %} {{ shop.name }} {% endcomment %}
      Waldon<span class="wd-nav-dot"></span>
    {%- endif -%}
  </a>

  <div class="wd-nav-links">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}"{% if link.active %} class="active"{% endif %}>{{ link.title }}</a>
    {% endfor %}
  </div>

  <div class="wd-nav-actions">
    <button class="wd-icon-btn" aria-label="Search">
      <i data-lucide="search"></i>
    </button>
    {%- if customer -%}
      <a href="{{ routes.account_url }}" class="wd-icon-btn" aria-label="{{ 'customer.account' | t }}">
        <i data-lucide="user"></i>
      </a>
    {%- else -%}
      <a href="{{ routes.account_login_url }}" class="wd-icon-btn" aria-label="{{ 'customer.log_in' | t }}">
        <i data-lucide="user"></i>
      </a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="wd-icon-btn wd-cart-btn" aria-label="Bag">
      <i data-lucide="shopping-bag"></i>
      {% if cart.item_count > 0 %}
        <span class="wd-cart-pip">{{ cart.item_count }}</span>
      {% endif %}
    </a>
  </div>
</nav>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}

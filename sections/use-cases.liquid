{%- liquid
  assign product_scenes = nil
  if product
    assign product_scenes = product.metafields.custom.use_case_scenes.value
  endif
-%}
{%- if section.settings.show_section -%}
<section class="uc-section section--use-cases" style="background: {{ section.settings.bg_color }};">
  <div class="uc-inner">
    <p class="uc-eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="uc-title">{{ section.settings.heading }}</h2>
    <div class="uc-grid uc-grid--cols-{{ section.settings.columns_desktop }}">

      {%- if product_scenes and product_scenes.size > 0 -%}
        {%- for mo in product_scenes -%}
          <div class="uc-card">
            <div class="uc-card__img uc-img--{{ mo.bg_style.value | default: 'clay' }}">
              {%- assign sc_image = mo.image.value -%}
              {%- if sc_image -%}
                {{ sc_image | image_url: width: 780 | image_tag: alt: sc_image.alt, loading: 'lazy', class: 'uc-card__photo' }}
              {%- endif -%}
            </div>
            <div class="uc-card__body">
              <p class="uc-card__eyebrow">{{ mo.eyebrow.value }}</p>
              <h3 class="uc-card__heading">{{ mo.heading.value }}</h3>
              <div class="uc-card__text">{{ mo.body.value }}</div>
            </div>
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'scene' -%}
            {%- liquid
              assign mo = block.settings.scene_ref
              if mo
                assign sc_eyebrow  = mo.eyebrow.value
                assign sc_heading  = mo.heading.value
                assign sc_body     = mo.body.value
                assign sc_image    = mo.image.value
                assign sc_bg_style = mo.bg_style.value | default: 'clay'
              else
                assign sc_eyebrow  = block.settings.eyebrow
                assign sc_heading  = block.settings.heading
                assign sc_body     = block.settings.body
                assign sc_image    = block.settings.image
                assign sc_bg_style = block.settings.bg_style
              endif
            -%}
            <div class="uc-card" {{ block.shopify_attributes }}>
              <div class="uc-card__img uc-img--{{ sc_bg_style }}">
                {%- if sc_image -%}
                  {{ sc_image | image_url: width: 780 | image_tag: alt: sc_image.alt, loading: 'lazy', class: 'uc-card__photo' }}
                {%- endif -%}
              </div>
              <div class="uc-card__body">
                <p class="uc-card__eyebrow">{{ sc_eyebrow }}</p>
                <h3 class="uc-card__heading">{{ sc_heading }}</h3>
                <div class="uc-card__text">{{ sc_body }}</div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.section--use-cases { border-bottom: 1px solid var(--stone-01); }
.uc-inner {
  max-width: var(--content-max, 1120px); margin: 0 auto;
  padding: 48px 18px;
}
@media (min-width: 768px) { .uc-inner { padding: 72px 48px; } }

.uc-eyebrow {
  font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--fg-muted); margin: 0 0 12px; font-weight: 500;
}
.uc-title {
  font-family: var(--font-display); font-weight: 400;
  font-size: clamp(24px,5vw,34px); line-height: 1.08; letter-spacing: -0.022em;
  color: var(--ink-00); margin: 0 0 24px;
}
.uc-title em { font-style: italic; font-weight: 300; color: var(--clay-500); }

.uc-title p {
  font-family: var(--font-display) !important; 
  font-weight: 500;
  font-size: 30px; 
  line-height: 1.08; 
  letter-spacing: -0.022em;
  margin: 0;
  color: black;
}

.uc-grid { display: flex; flex-direction: column; gap: 12px; }
@media (min-width: 768px) {
  .uc-grid--cols-2 { display: grid; grid-template-columns: repeat(2,1fr); }
  .uc-grid--cols-3 { display: grid; grid-template-columns: repeat(3,1fr); }
  .uc-grid--cols-4 { display: grid; grid-template-columns: repeat(4,1fr); }
}

.uc-card {
  background: var(--paper-00); border: 1px solid var(--stone-01);
  border-radius: var(--radius-lg); overflow: hidden;
}
.uc-card__img {
  aspect-ratio: 1/1; position: relative; overflow: hidden;
}
.uc-card__photo { width: 100%; height: 100%; object-fit: cover; }

/* Illustration placeholders */
.uc-img--clay    { background: linear-gradient(155deg, #ECE6D6, #C98E6A 95%); }
.uc-img--stone   { background: linear-gradient(155deg, #D9D3C3, #8A8172 95%); }
.uc-img--sage    { background: linear-gradient(155deg, #E9EEDF, #6B7860 95%); }
.uc-img--dark    { background: linear-gradient(160deg, #3A3731, #1A1815 70%); }
.uc-img--default { background: var(--paper-02); }

.uc-card__body { padding: 18px 20px 20px; }
.uc-card__eyebrow {
  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.14em;
  text-transform: uppercase; color: var(--clay-500); margin: 0 0 6px; font-weight: 500;
}
.uc-card__heading {
  font-family: var(--font-display); font-size: 22px; font-weight: 400;
  margin: 0 0 8px; color: var(--ink-00); letter-spacing: -0.015em;
}
.uc-card__text { margin: 0; font-size: 13.5px; color: var(--fg-body); line-height: 1.55; }
.uc-card__text p { 
    margin: 0;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
 }
{% endstylesheet %}

{% schema %}
{
  "name": "Use cases",
  "tag": "section",
  "class": "section section--use-cases",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show section", "default": true },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#F5F1E8" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Who it's for" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Made for <em>your day,</em> not a gym bro's.</p>" },
    { "type": "select", "id": "columns_desktop", "label": "Columns (desktop)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2" }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Scene card",
      "limit": 8,
      "settings": [
        {
          "type": "metaobject",
          "id": "scene_ref",
          "label": "Use case scene (metaobject)",
          "metaobject_type": "use_case_scene"
        },
        { "type": "header", "content": "Manual override" },
        { "type": "image_picker", "id": "image", "label": "Scene image (optional)" },
        { "type": "select", "id": "bg_style", "label": "Illustration background",
          "options": [
            { "value": "clay", "label": "Clay (warm brown)" },
            { "value": "stone", "label": "Stone (gray)" },
            { "value": "sage", "label": "Sage (green)" },
            { "value": "dark", "label": "Dark (night)" },
            { "value": "default", "label": "Default (cream)" }
          ],
          "default": "clay" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "For the stairs" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Up and down, without the bargain." },
        { "type": "richtext", "id": "body", "label": "Body text", "default": "<p>The compression supports the patellar tendon on every step, so you stop negotiating with your house.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Use cases" }]
}
{% endschema %}
